# Copy this file to `secrets.toml` for local development. Both files are
# git-ignored. The DEPLOYED dashboard runs in `DASHBOARD_SOURCE=snapshot`
# mode and does NOT need any of these — the Parquet files in
# `dashboard/data/` carry all the numbers.
#
# You only need this file if you want to:
#   1. Re-snapshot the SPY benchmark from Alpaca, OR
#   2. Run the dashboard against the live Postgres DB
#      (`DASHBOARD_SOURCE=live`).

# ── Alpaca paper-trading credentials (used by load_spy_benchmark in live mode) ──
ALPACA_API_KEY    = "PK..."
ALPACA_SECRET_KEY = "..."

# ── Live Postgres connection (used by st.connection in live mode) ──────────────
[connections.postgresql]
dialect  = "postgresql"
host     = "your-db-host"
port     = "5432"
database = "tradingagent"
username = "trader"
password = "..."
